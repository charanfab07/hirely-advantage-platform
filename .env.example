# Copy to .env and fill in real values. Never commit .env.
# Only PUBLISHABLE / anon keys belong in VITE_* variables — they ship to the browser.
# NEVER put service-role keys, OpenAI keys, Razorpay/Stripe secrets, or any
# payment verification secrets in VITE_* variables. Store those as backend
# secrets (edge function secrets) instead.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
